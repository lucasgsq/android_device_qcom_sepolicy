binder_use(mm-qcamerad)

# Sockets moved to /dev/camera (device policy).
allow mm-qcamerad camera_socket:sock_file { create unlink write };
allow mm-qcamerad camera_data_file:sock_file { create unlink };
allow mm-qcamerad system_data_root_file:dir search;

allow mm-qcamerad system_server:unix_stream_socket rw_socket_perms;
allow mm-qcamerad sensorservice_service:service_manager find;

# Existing /data/fdAlbum remains readable; new album is /data/cam/fdb.

allow mm-qcamerad camera_data_file:file create_file_perms;

r_dir_file(mm-qcamerad, sysfs_graphics)
