# Separate legacy core data from /data/vendor labels.
# Explicit accesses mirror the actual stage27 policy; no new clients.
type quark_vendor_cnd_data_file, file_type, data_file_type;
type quark_vendor_display_data_file, file_type, data_file_type;
type quark_vendor_iop_data_file, file_type, data_file_type;
type quark_vendor_mpctl_data_file, file_type, data_file_type;
type quark_vendor_port_bridge_data_file, file_type, data_file_type;
allow cnd quark_vendor_cnd_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow cnd quark_vendor_cnd_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow cnd quark_vendor_cnd_data_file:sock_file { create setattr unlink };
allow dataservice_app quark_vendor_cnd_data_file:dir { search };
allow dataservice_app quark_vendor_cnd_data_file:file { getattr ioctl lock map open read watch watch_reads };
allow hal_graphics_composer quark_vendor_display_data_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow hal_graphics_composer quark_vendor_display_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow hal_iop_default quark_vendor_iop_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow hal_iop_default quark_vendor_iop_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow hal_lineage_livedisplay_qti quark_vendor_display_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow hal_lineage_livedisplay_qti quark_vendor_display_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow hal_perf_default quark_vendor_mpctl_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow hal_perf_default quark_vendor_mpctl_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow mm-pp-daemon quark_vendor_display_data_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow mm-pp-daemon quark_vendor_display_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow mpdecision quark_vendor_mpctl_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow mpdecision quark_vendor_mpctl_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow perfd quark_vendor_mpctl_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow perfd quark_vendor_mpctl_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow port-bridge quark_vendor_port_bridge_data_file:dir { add_name lock open remove_name search write };
allow port-bridge quark_vendor_port_bridge_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow qti_init_shell quark_vendor_mpctl_data_file:dir { add_name lock open remove_name search write };
allow qti_init_shell quark_vendor_mpctl_data_file:file { getattr unlink write };
allow surfaceflinger quark_vendor_display_data_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow surfaceflinger quark_vendor_display_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow system_app quark_vendor_cnd_data_file:dir { add_name lock open remove_name search write };
allow system_app quark_vendor_cnd_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow system_server quark_vendor_cnd_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow system_server quark_vendor_cnd_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
