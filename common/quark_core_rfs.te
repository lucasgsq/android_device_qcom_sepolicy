# Distinct core RFS data; persistent RFS labels remain unchanged.
type quark_core_rfs_file, file_type, data_file_type, core_data_file_type;
type quark_core_rfs_shared_hlos_file, file_type, data_file_type, core_data_file_type;
allow location quark_core_rfs_shared_hlos_file:dir { getattr ioctl lock open read search watch watch_reads };
allow location quark_core_rfs_shared_hlos_file:file { append getattr ioctl lock map open read watch watch_reads write };
allow rfs_access quark_core_rfs_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow rfs_access quark_core_rfs_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow rfs_access quark_core_rfs_shared_hlos_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow rfs_access quark_core_rfs_shared_hlos_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };

# Preserve the original RFS write restrictions, including userdebug/eng scope.
neverallow { domain -rfs_access -kernel -recovery -init -vendor_init userdebug_or_eng(`-su') -qti_init_shell } quark_core_rfs_file:dir create_dir_perms;
neverallow { domain -rfs_access -kernel -recovery -init -vendor_init userdebug_or_eng(`-su') -qti_init_shell } quark_core_rfs_file:file create_file_perms;
